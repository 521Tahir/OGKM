# ── LLM Backend — choose ONE ────────────────────────────────────────────────

# Option A: Llama-3.1-8B-Instruct (recommended — requires HF token + Meta license)
#   Step 1: Accept Meta license at https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct
#   Step 2: Create token at https://huggingface.co/settings/tokens
#   Step 3: Download: python scripts/download_model.py --model llama3.1-8b --verify
HF_TOKEN=your_huggingface_token_here
LOCAL_MODEL_KEY=llama3.1-8b

# Option B: Open model (no token needed — runs immediately)
# LOCAL_MODEL_KEY=qwen2.5-7b
# Qwen2.5-7B-Instruct is fully open and comparable quality

# Option C: Anthropic Claude API
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── GPU configuration ─────────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=5,6,7,8,9

# ── Storage ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./artifacts/mlruns
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
ARTIFACTS_PATH=./artifacts

# ── Neo4j (optional, Phase 6) ─────────────────────────────────────────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password

# ── KMA Weather API (optional — FREE) ─────────────────────────────────────────
# Korea Meteorological Administration live forecasts for Jeju.
# Without a key the system uses Jeju climate-normals (offline fallback) — still works.
#   Step 1: Sign up free at https://www.data.go.kr
#   Step 2: Request "기상청_단기예보 ((구) 동네예보) 조회서비스"
#   Step 3: Paste the issued (decoded) service key below.
# KMA_API_KEY=your_kma_service_key_here

# ── Reproducibility ───────────────────────────────────────────────────────────
RANDOM_SEED=42
LOG_LEVEL=INFO
LOG_FILE=./artifacts/runs/app.log
